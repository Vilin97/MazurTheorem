theorem test
    (r s : ℚ)
    (hr : r ≠ 0) (hs : s ≠ 0)
    (hA : A r s ≠ 0) (hB : B r s ≠ 0) (hC : C r s ≠ 0)
    (hK : K r s ≠ 0) (hD : D r s ≠ 0) (hE : E r s ≠ 0)
    (hL : L r s ≠ 0) (hJ : J r s ≠ 0)
    (hP6 : P6 r s ≠ 0) (hP9 : P9 r s ≠ 0)
    (hF : rawF r s = 0) :
    MazurTorsion.Kubert.orderTwentyFiveOrbitRelationZero
      (aa r s) (bb r s) (cc r s) (dd r s) 0 = 0 := by
  have hab : aa r s * bb r s = aabb r s := by
    simp only [aa, bb, aabb]
    field_simp [hr, hs, hA, hB, hC, hK, hD, hE, hL, hJ, hP6, hP9]
  have had : aa r s * dd r s = aadd r s := by
    simp only [aa, dd, aadd]
    field_simp [hr, hs, hA, hB, hC, hK, hD, hE, hL, hJ, hP6, hP9]
  simp only [MazurTorsion.Kubert.orderTwentyFiveOrbitRelationZero]
  rw [mul_sub, hab, had]
  simp only [aa, cc, aabb, aadd]
  field_simp [hr, hs, hA, hB, hC, hK, hD, hE, hL, hJ, hP6, hP9]
  have hFq : ((r - 1) * T r s * Q r s) * rawF r s = 0 := by
    rw [hF]
    ring
  simp only [A, B, C, K, D, E, L, J, T, M, N, P6, P9,
    rawF, rawFC0, rawFC1, rawFC2, rawFC3, rawFC4, rawFC5,
    rawFC6, rawFC7, rawFC8, rawFC9, rawFC10,
    Q, QC0, QC1, QC2, QC3, QC4, QC5, QC6, QC7, QC8, QC9,
    QC10, QC11, QC12, QC13, QC14, QC15, QC16, QC17, QC18, QC19] at hFq ⊢
  linear_combination hFq

end ScratchR0
