theorem relation_2
    (r s : ℚ) (hr : r ≠ 0) (hA : A r s ≠ 0) (hB : B r s ≠ 0) (hC : C r s ≠ 0) (hK : K r s ≠ 0) (hD : D r s ≠ 0) (hE : E r s ≠ 0) (hL : L r s ≠ 0) (hJ : J r s ≠ 0) (hP6 : P6 r s ≠ 0)
    (hF : F r s = 0) :
    y4 r s - y2 r s - y4 r s * y1 r s * (y8 r s - y4 r s) = 0 := by
  have hpoly : term0 r s + term1 r s + term2 r s + term3 r s = 0 := by
    rw [polynomial_certificate, hF]
    ring
  simp only [y1, y2, y4, y8]
  field_simp [hr, hA, hB, hC, hK, hD, hE, hL, hJ, hP6]
  simp only [term0, term1, term2, term3] at hpoly
  linear_combination hpoly

