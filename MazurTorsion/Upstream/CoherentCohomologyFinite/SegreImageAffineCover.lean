import MazurTorsion.Upstream.CoherentCohomologyFinite.SegreProductProjComparison


/-!
# Standard affine charts on the Segre image

The images of the standard Segre coordinates are homogeneous of degree
one and generate an ideal containing the irrelevant ideal.  They
therefore give a finite affine open cover of the `Proj` of the Segre
image algebra.
-/

open CategoryTheory AlgebraicGeometry TopologicalSpace
open HomogeneousIdeal MvPolynomial

noncomputable section

universe u

namespace MazurTorsion.AlgebraicGeometry.CoherentCohomology.ProjectiveSpace

/-- A standard homogeneous coordinate of the Segre image algebra. -/
def segreImageCoordinate
    (k : Type u) [CommRing k] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    SegreCoordinateRing k m n :=
  segreRangeCoordinateHom k m n (MvPolynomial.X i)

lemma segreImageCoordinate_mem_degreeOne
    (k : Type u) [CommRing k] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    segreImageCoordinate k m n i ∈
      segreImageGrading k m n 1 :=
  segreRangeCoordinateHom_mem_imageGrading
    k m n (coordinate_mem_degreeOne k i)

/-- The irrelevant ideal of the Segre image is contained in the ideal
generated by its standard coordinates. -/
lemma segreImageIrrelevant_le_coordinateIdeal
    (k : Type u) [CommRing k] (m n : ℕ) :
    (segreImageGrading k m n)₊.toIdeal ≤
      Ideal.span
        (Set.range (segreImageCoordinate k m n)) := by
  have hmap :
      Ideal.map
          (segreImageGradedHom k m n)
          ((homogeneousGrading k
            (segreDimension m n))₊).toIdeal ≤
        Ideal.span
          (Set.range (segreImageCoordinate k m n)) := by
    refine (Ideal.map_mono
      (irrelevant_le_coordinateIdeal
        k (segreDimension m n))).trans ?_
    rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨i, rfl⟩
  intro x hx
  exact hmap (segreImageIrrelevantLE k m n hx)

/-- The standard coordinate chart on the `Proj` of the Segre image. -/
def segreImageStandardChart
    (k : Type u) [CommRing k] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    (Proj (segreImageGrading k m n)).Opens :=
  Proj.basicOpen
    (segreImageGrading k m n)
    (segreImageCoordinate k m n i)

lemma iSup_segreImageStandardChart
    (k : Type u) [CommRing k] (m n : ℕ) :
    ⨆ i, segreImageStandardChart k m n i = ⊤ :=
  Proj.iSup_basicOpen_eq_top
    (segreImageGrading k m n)
    (segreImageCoordinate k m n)
    (segreImageIrrelevant_le_coordinateIdeal k m n)

/-- The standard Segre-image charts as a finite affine open cover. -/
def segreImageAffineOpenCover
    (k : Type u) [CommRing k] (m n : ℕ) :
    (Proj (segreImageGrading k m n)).AffineOpenCover :=
  Proj.affineOpenCoverOfIrrelevantLESpan
    (segreImageGrading k m n)
    (segreImageCoordinate k m n)
    (m := fun _ => 1)
    (segreImageCoordinate_mem_degreeOne k m n)
    (fun _ => Nat.zero_lt_one)
    (segreImageIrrelevant_le_coordinateIdeal k m n)

instance isOpenImmersion_segreImageAffineOpenCover
    (k : Type u) [CommRing k] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    IsOpenImmersion ((segreImageAffineOpenCover k m n).f i) :=
  (segreImageAffineOpenCover k m n).map_prop i

@[simp]
lemma segreImageAffineOpenCover_opensRange
    (k : Type u) [CommRing k] (m n : ℕ)
    (i : Fin (segreDimension m n + 1)) :
    ((segreImageAffineOpenCover k m n).f i).opensRange =
      segreImageStandardChart k m n i := by
  change
    (Proj.awayι
      (segreImageGrading k m n)
      (segreImageCoordinate k m n i)
      (segreImageCoordinate_mem_degreeOne k m n i)
      Nat.zero_lt_one).opensRange =
      segreImageStandardChart k m n i
  exact Proj.opensRange_awayι
    (segreImageGrading k m n)
    (segreImageCoordinate k m n i)
    (segreImageCoordinate_mem_degreeOne k m n i)
    Nat.zero_lt_one

end MazurTorsion.AlgebraicGeometry.CoherentCohomology.ProjectiveSpace
