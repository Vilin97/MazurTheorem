import MazurTorsion.Upstream.LeanPool.GrothendieckVanishing.ZeroOutside

/-!
# Generated subsheaves via coproduct images

Generic coproduct-image API used to express subsheaves generated by a family of local
sections.

## Main definitions

* `TopCat.Sheaf.familyMap` — the universal map from a family coproduct into a sheaf.
* `TopCat.Sheaf.familyImage` — the image subsheaf generated by such a family.
* `TopCat.Presheaf.SectionIndex` — generic indexing type for local sections of a presheaf.
* `TopCat.Presheaf.finsetGeneratorMap`, `TopCat.Presheaf.finsetGeneratedSheaf` —
  finite-section wrappers around the same generated-subsheaf construction.
* `TopCat.Presheaf.allSectionMap` — the canonical coproduct map from all
  `zeroOutsideInt` generators of `F`, together with its `Epi` instance.
-/

universe u

open CategoryTheory TopologicalSpace Limits Opposite

noncomputable section

namespace TopCat

namespace Sheaf

/-- For a family of morphisms into `F`, the universal map from their coproduct into `F`. -/
abbrev familyMap {C : Type*} [Category C] {X : TopCat.{u}} {ι : Type*}
    (G : ι → Sheaf C X) {F : Sheaf C X} (f : ∀ i, G i ⟶ F)
    [HasCoproduct G] :
    (∐ G) ⟶ F :=
  Sigma.desc f

/-- The image subsheaf generated by a family of morphisms into `F`. -/
abbrev familyImage {C : Type*} [Category C] {X : TopCat.{u}} {ι : Type*}
    (G : ι → Sheaf C X) {F : Sheaf C X} (f : ∀ i, G i ⟶ F)
    [HasCoproduct G] [HasImage (familyMap G f)] :
    Sheaf C X :=
  Limits.image (familyMap G f)

end Sheaf

namespace Presheaf

/-- Indexing type for all local sections of a presheaf. -/
abbrev SectionIndex {C : Type*} [Category C] {FC : C → C → Type*} {CC : C → Type*}
    [∀ X Y, FunLike (FC X Y) (CC X) (CC Y)] [ConcreteCategory C FC] {X : TopCat.{u}}
    (F : TopCat.Presheaf C X) :=
  Σ U : Opens X, ToType (F.obj (op U))

/-- The canonical map attached to a finite set of local sections. -/
abbrev finsetGeneratorMap {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    (S : Finset (SectionIndex F))
    [HasCoproduct fun σ : {σ // σ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt σ.1.1] :
    (∐ fun σ : {σ // σ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt σ.1.1) ⟶
      (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X) :=
  TopCat.Sheaf.familyMap
    (fun σ : {σ // σ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt σ.1.1)
    (fun σ ↦ TopCat.Sheaf.zeroOutsideInt.sHom
      (F := (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X)) σ.1.2)

/-- The subsheaf of `F` generated by a finite set of local sections. -/
abbrev finsetGeneratedSheaf {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    (S : Finset (SectionIndex F))
    [HasCoproduct fun σ : {σ // σ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt σ.1.1] :
    TopCat.Sheaf AddCommGrpCat.{u} X :=
  Abelian.image (finsetGeneratorMap hF S)

/-- Coproduct inclusion induced by `S ⊆ S'` on the finite generator coproducts. -/
noncomputable def finsetCoproductInclGen {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X}
    {S S' : Finset (SectionIndex F)}
    (h : S ⊆ S') :
    (∐ fun σ : {σ // σ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt σ.1.1) ⟶
      (∐ fun σ : {σ // σ ∈ S'} ↦ TopCat.Sheaf.zeroOutsideInt σ.1.1) :=
  Sigma.desc fun σ ↦
    Sigma.ι (fun τ : {τ // τ ∈ S'} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1) ⟨σ.1, h σ.2⟩

theorem finsetCoproductInclGen_ι {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X}
    {S S' : Finset (SectionIndex F)} (h : S ⊆ S') (σ : {σ // σ ∈ S}) :
    Sigma.ι (fun τ : {τ // τ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1) σ ≫
        finsetCoproductInclGen h =
      Sigma.ι (fun τ : {τ // τ ∈ S'} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1)
        ⟨σ.1, h σ.2⟩ := by
  unfold finsetCoproductInclGen
  exact Sigma.ι_desc _ _

theorem finsetGeneratorMap_ι {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    (S : Finset (SectionIndex F)) (σ : {σ // σ ∈ S}) :
    Sigma.ι (fun τ : {τ // τ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1) σ ≫
        finsetGeneratorMap hF S =
      TopCat.Sheaf.zeroOutsideInt.sHom
        (F := (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X)) σ.1.2 := by
  exact Sigma.ι_desc _ _

theorem finsetCoproductInclGen_comp_generatorMap {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    {S S' : Finset (SectionIndex F)} (h : S ⊆ S') :
    finsetCoproductInclGen h ≫ finsetGeneratorMap hF S' = finsetGeneratorMap hF S := by
  ext ⟨σ, hσ⟩
  calc
    Sigma.ι (fun τ : {τ // τ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1) ⟨σ, hσ⟩ ≫
          (finsetCoproductInclGen h ≫ finsetGeneratorMap hF S') =
        (Sigma.ι (fun τ : {τ // τ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1)
          ⟨σ, hσ⟩ ≫ finsetCoproductInclGen h) ≫ finsetGeneratorMap hF S' :=
      (Category.assoc _ _ _).symm
    _ = Sigma.ι (fun τ : {τ // τ ∈ S'} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1)
          ⟨σ, h hσ⟩ ≫ finsetGeneratorMap hF S' := by
      exact congrArg (fun k ↦ k ≫ finsetGeneratorMap hF S')
        (finsetCoproductInclGen_ι h ⟨σ, hσ⟩)
    _ = TopCat.Sheaf.zeroOutsideInt.sHom
          (F := (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X)) σ.2 :=
      finsetGeneratorMap_ι hF S' ⟨σ, h hσ⟩
    _ = Sigma.ι (fun τ : {τ // τ ∈ S} ↦ TopCat.Sheaf.zeroOutsideInt τ.1.1) ⟨σ, hσ⟩ ≫
          finsetGeneratorMap hF S := by
      exact (finsetGeneratorMap_ι hF S ⟨σ, hσ⟩).symm

/-- Inclusion of finitely generated subsheaves induced by `S ⊆ S'`. -/
noncomputable def finsetImageInclGen {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    {S S' : Finset (SectionIndex F)}
    (h : S ⊆ S') :
    TopCat.Presheaf.finsetGeneratedSheaf hF S ⟶ TopCat.Presheaf.finsetGeneratedSheaf hF S' :=
  kernel.lift (cokernel.π (finsetGeneratorMap hF S'))
    (Abelian.image.ι (finsetGeneratorMap hF S)) (by
      apply Abelian.image_ι_comp_eq_zero
      calc
        finsetGeneratorMap hF S ≫ cokernel.π (finsetGeneratorMap hF S') =
            (finsetCoproductInclGen h ≫ finsetGeneratorMap hF S') ≫
              cokernel.π (finsetGeneratorMap hF S') := by
          rw [finsetCoproductInclGen_comp_generatorMap hF h]
        _ = finsetCoproductInclGen h ≫
              (finsetGeneratorMap hF S' ≫ cokernel.π (finsetGeneratorMap hF S')) :=
          Category.assoc _ _ _
        _ = 0 := by
          exact (congrArg (fun k ↦ finsetCoproductInclGen h ≫ k)
            (cokernel.condition (finsetGeneratorMap hF S'))).trans
              comp_zero)

theorem finsetImageInclGen_comp_ι {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    {S S' : Finset (SectionIndex F)}
    (h : S ⊆ S') :
    finsetImageInclGen hF h ≫
        Abelian.image.ι (TopCat.Presheaf.finsetGeneratorMap hF S') =
      Abelian.image.ι (TopCat.Presheaf.finsetGeneratorMap hF S) := by
  change kernel.lift _ _ _ ≫ kernel.ι _ = _
  exact kernel.lift_ι _ _ _

instance finsetImageInclGen_mono {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    {S S' : Finset (SectionIndex F)}
    (h : S ⊆ S') :
    Mono (finsetImageInclGen hF h) := by
  constructor
  intro Z g₁ g₂ hcomp
  apply Fork.IsLimit.hom_ext (kernelIsKernel (cokernel.π (finsetGeneratorMap hF S)))
  have hι := finsetImageInclGen_comp_ι hF h
  have hfinal : g₁ ≫ Abelian.image.ι (finsetGeneratorMap hF S) =
      g₂ ≫ Abelian.image.ι (finsetGeneratorMap hF S) := by
    calc
    g₁ ≫ Abelian.image.ι (finsetGeneratorMap hF S) =
        g₁ ≫ (finsetImageInclGen hF h ≫
          Abelian.image.ι (finsetGeneratorMap hF S')) :=
      congrArg (fun k ↦ g₁ ≫ k) hι.symm
    _ = (g₁ ≫ finsetImageInclGen hF h) ≫
          Abelian.image.ι (finsetGeneratorMap hF S') :=
      (Category.assoc _ _ _).symm
    _ = (g₂ ≫ finsetImageInclGen hF h) ≫
          Abelian.image.ι (finsetGeneratorMap hF S') :=
      congrArg (fun k ↦ k ≫ Abelian.image.ι (finsetGeneratorMap hF S')) hcomp
    _ = g₂ ≫ (finsetImageInclGen hF h ≫
          Abelian.image.ι (finsetGeneratorMap hF S')) :=
      Category.assoc _ _ _
    _ = g₂ ≫ Abelian.image.ι (finsetGeneratorMap hF S) :=
      congrArg (fun k ↦ g₂ ≫ k) hι
  exact hfinal

/-- The canonical map from the coproduct of all `zeroOutsideInt U` indexed by local sections
of `F` onto the sheaf associated to `F`. This is the formal Step 3A starting point for
building finitely generated subsheaves via images of smaller subcoproducts. -/
abbrev allSectionMap {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    [HasCoproduct (fun σ : SectionIndex F ↦ TopCat.Sheaf.zeroOutsideInt σ.1)] :
    (∐ fun σ : SectionIndex F ↦ TopCat.Sheaf.zeroOutsideInt σ.1) ⟶
      (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X) :=
  TopCat.Sheaf.familyMap
    (fun σ : SectionIndex F ↦ TopCat.Sheaf.zeroOutsideInt σ.1)
    (fun σ ↦ TopCat.Sheaf.zeroOutsideInt.sHom
      (F := (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X)) σ.2)

instance allSectionMap_epi {X : TopCat.{u}}
    {F : TopCat.Presheaf AddCommGrpCat.{u} X} (hF : F.IsSheaf)
    [HasCoproduct (fun σ : SectionIndex F ↦ TopCat.Sheaf.zeroOutsideInt σ.1)] :
    Epi (allSectionMap hF) := by
  letI : Balanced (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) :=
    balanced_of_strongEpiCategory
  rw [← TopCat.Sheaf.isLocallySurjective_iff_epi (allSectionMap hF)]
  rw [TopCat.Presheaf.isLocallySurjective_iff]
  intro U t x hx
  refine ⟨U, le_rfl, ?_, hx⟩
  refine ⟨(Sigma.ι (fun σ : SectionIndex F ↦ TopCat.Sheaf.zeroOutsideInt σ.1)
      ⟨U, t⟩).hom.app (op U) (TopCat.Sheaf.zeroOutsideInt.generator U), ?_⟩
  change (((Sigma.ι (fun σ : SectionIndex F ↦ TopCat.Sheaf.zeroOutsideInt σ.1)
      ⟨U, t⟩) ≫ allSectionMap hF).hom.app (op U) (TopCat.Sheaf.zeroOutsideInt.generator U)) =
    TopCat.Presheaf.restrictOpen t U le_rfl
  have hι :
      Sigma.ι (fun σ : SectionIndex F ↦ TopCat.Sheaf.zeroOutsideInt σ.1) ⟨U, t⟩ ≫
          allSectionMap hF =
        TopCat.Sheaf.zeroOutsideInt.sHom
          (F := (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X)) t := by
    exact Sigma.ι_desc _ _
  rw [hι]
  simpa only [TopCat.Presheaf.restrict_self] using
    (TopCat.Sheaf.zeroOutsideInt.sHom_app_generator
      (F := (⟨F, hF⟩ : TopCat.Sheaf AddCommGrpCat.{u} X)) t)

end Presheaf

end TopCat
