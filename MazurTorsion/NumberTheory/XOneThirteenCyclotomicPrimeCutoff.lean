import MazurTorsion.NumberTheory.XOneThirteenCyclotomicMinkowski
import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal
import Mathlib.Tactic.NormNum.Prime

/-!
# Exceptional rational primes for the thirteenth cyclotomic field

The residue degree of an unramified rational prime in `ℚ(ζ₁₃)` is the
multiplicative order of that prime modulo `13`.  Combined with the checked
Minkowski cutoff, the following finite certificate leaves exactly the six
norms `27, 13, 53, 79, 131, 157` to be generated by principal ideals.
-/

namespace MazurTorsion.XOneThirteenCyclotomic

open Nat
open NumberField Ideal

local instance : Fact (Nat.Prime 13) := ⟨by decide⟩

/-- The six rational primes whose least possible prime-ideal norm is at most
the Minkowski cutoff. -/
def exceptionalPrimes : Finset ℕ := {3, 13, 53, 79, 131, 157}

private theorem orderOf_two_mod_thirteen :
    orderOf (2 : ZMod 13) = 12 := by
  rw [orderOf_eq_iff (by norm_num)]
  constructor
  · decide
  · intro m hm hm0
    interval_cases m <;> decide

private theorem orderOf_three_mod_thirteen :
    orderOf (3 : ZMod 13) = 3 := by
  rw [orderOf_eq_iff (by norm_num)]
  constructor
  · decide
  · intro m hm hm0
    interval_cases m <;> decide

private theorem orderOf_four_mod_thirteen :
    orderOf (4 : ZMod 13) = 6 := by
