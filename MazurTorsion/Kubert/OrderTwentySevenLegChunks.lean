import MazurTorsion.Kubert.OrderTwentySevenTrisection

/-!
# Chunk definitions for the third leg

Definitions supporting the third hauptmodul leg: the kernel cubic, the staged chunk values of the two certificate chains, and the Bezout cofactors.
-/

namespace MazurTorsion.Kubert

lemma quad_ne (f : ℚ) : f ^ 2 - f + 1 ≠ 0 := by
  intro h
  nlinarith [sq_nonneg (2 * f - 1)]

/-- The kernel cubic of the third story of the tower. -/
def kernelCubicM (f Z : ℚ) : ℚ :=
  Z ^ 3 + -(3 * f * (f - 1) ^ 2 * (f ^ 2 + f - 1)) * Z ^ 2 + -(3 * f * (f - 1) * (3 * f ^ 9 - f ^
    8 - 26 * f ^ 7 + 94 * f ^ 6 - 168 * f ^ 5 + 187 * f ^ 4 - 145 * f ^ 3 + 76 * f ^ 2 - 26 * f +
    3)) * Z + -(f * (f - 1) * (f ^ 15 + 24 * f ^ 14 - 191 * f ^ 13 + 768 * f ^ 12 - 2105 * f ^ 11
    + 4341 * f ^ 10 - 7010 * f ^ 9 + 9075 * f ^ 8 - 9491 * f ^ 7 + 7985 * f ^ 6 - 5312 * f ^ 5 +
    2713 * f ^ 4 - 1020 * f ^ 3 + 259 * f ^ 2 - 39 * f + 1))

