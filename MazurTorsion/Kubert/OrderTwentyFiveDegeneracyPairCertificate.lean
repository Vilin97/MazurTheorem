private theorem bd_checked_all
    (outer inner : ℕ) (hOuter : outer < 18) (hInner : inner < 25) :
    expressionCoefficient bdLeftExpression outer inner =
      expressionCoefficient bdRightExpression outer inner := by
  exact
    if h0 : outer < 2 then by
      exact bd_checked_outer_0_1 outer
        (by omega) (by omega) inner hInner
    else if h2 : outer < 4 then by
      exact bd_checked_outer_2_3 outer
        (by omega) (by omega) inner hInner
    else if h4 : outer < 6 then by
      exact bd_checked_outer_4_5 outer
        (by omega) (by omega) inner hInner
    else if h6 : outer < 8 then by
      exact bd_checked_outer_6_7 outer
        (by omega) (by omega) inner hInner
    else if h8 : outer < 10 then by
      exact bd_checked_outer_8_9 outer
        (by omega) (by omega) inner hInner
    else if h10 : outer < 12 then by
      exact bd_checked_outer_10_11 outer
        (by omega) (by omega) inner hInner
    else if h12 : outer < 14 then by
      exact bd_checked_outer_12_13 outer
        (by omega) (by omega) inner hInner
    else if h14 : outer < 16 then by
      exact bd_checked_outer_14_15 outer
        (by omega) (by omega) inner hInner
    else if h16 : outer < 18 then by
      exact bd_checked_outer_16_17 outer
        (by omega) (by omega) inner hInner
    else by
      omega

theorem bd_polynomial :
    expressionPolynomial bdLeftExpression =
      expressionPolynomial bdRightExpression := by
  have hLeftOuter : bdLeftExpression.outerBound ≤ 18 := by decide
  have hRightOuter : bdRightExpression.outerBound ≤ 18 := by decide
  have hLeftInner : bdLeftExpression.innerBound ≤ 25 := by decide
  have hRightInner : bdRightExpression.innerBound ≤ 25 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 18
  · by_cases hInner : inner < 25
    · exact bd_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bdLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bdRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bdLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bdRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bd_evaluation (r s : ℚ) :
    evaluateExpression bdLeftExpression r s =
      evaluateExpression bdRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bd_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

