        (by omega) (by omega) inner hInner
    else if h2 : outer < 4 then by
      exact aSquared_checked_outer_2_3 outer
        (by omega) (by omega) inner hInner
    else if h4 : outer < 6 then by
      exact aSquared_checked_outer_4_5 outer
        (by omega) (by omega) inner hInner
    else if h6 : outer < 8 then by
