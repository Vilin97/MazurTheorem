private theorem ac_checked_all
    (outer inner : ℕ) (hOuter : outer < 17) (hInner : inner < 25) :
    expressionCoefficient acLeftExpression outer inner =
      expressionCoefficient acRightExpression outer inner := by
  exact
    if h0 : outer < 2 then by
      exact ac_checked_outer_0_1 outer
        (by omega) (by omega) inner hInner
    else if h2 : outer < 4 then by
      exact ac_checked_outer_2_3 outer
        (by omega) (by omega) inner hInner
    else if h4 : outer < 6 then by
      exact ac_checked_outer_4_5 outer
        (by omega) (by omega) inner hInner
    else if h6 : outer < 8 then by
      exact ac_checked_outer_6_7 outer
        (by omega) (by omega) inner hInner
    else if h8 : outer < 10 then by
      exact ac_checked_outer_8_9 outer
        (by omega) (by omega) inner hInner
    else if h10 : outer < 12 then by
      exact ac_checked_outer_10_11 outer
        (by omega) (by omega) inner hInner
    else if h12 : outer < 14 then by
      exact ac_checked_outer_12_13 outer
        (by omega) (by omega) inner hInner
    else if h14 : outer < 16 then by
      exact ac_checked_outer_14_15 outer
        (by omega) (by omega) inner hInner
    else if h16 : outer < 17 then by
      exact ac_checked_outer_16_16 outer
        (by omega) (by omega) inner hInner
    else by
      omega

theorem ac_polynomial :
    expressionPolynomial acLeftExpression =
      expressionPolynomial acRightExpression := by
  have hLeftOuter : acLeftExpression.outerBound ≤ 17 := by decide
  have hRightOuter : acRightExpression.outerBound ≤ 17 := by decide
  have hLeftInner : acLeftExpression.innerBound ≤ 25 := by decide
  have hRightInner : acRightExpression.innerBound ≤ 25 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 17
  · by_cases hInner : inner < 25
    · exact ac_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge acLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge acRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge acLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge acRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem ac_evaluation (r s : ℚ) :
    evaluateExpression acLeftExpression r s =
      evaluateExpression acRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) ac_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

