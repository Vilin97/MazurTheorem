  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 17
  · by_cases hInner : inner < 24
    · exact pairDenominatorInner_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge pairDenominatorInnerLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge pairDenominatorInnerRightExpression outer inner
