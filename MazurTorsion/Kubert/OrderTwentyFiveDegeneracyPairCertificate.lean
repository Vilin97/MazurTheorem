theorem aSquared_polynomial :
    expressionPolynomial aSquaredLeftExpression =
      expressionPolynomial aSquaredRightExpression := by
  have hLeftOuter : aSquaredLeftExpression.outerBound ≤ 14 := by decide
  have hRightOuter : aSquaredRightExpression.outerBound ≤ 14 := by decide
  have hLeftInner : aSquaredLeftExpression.innerBound ≤ 20 := by decide
  have hRightInner : aSquaredRightExpression.innerBound ≤ 20 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 14
  · by_cases hInner : inner < 20
    · exact aSquared_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge aSquaredLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge aSquaredRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge aSquaredLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge aSquaredRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem aSquared_evaluation (r s : ℚ) :
    evaluateExpression aSquaredLeftExpression r s =
      evaluateExpression aSquaredRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) aSquared_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

