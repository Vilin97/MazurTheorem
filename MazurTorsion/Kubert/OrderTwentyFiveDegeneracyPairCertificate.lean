private theorem bSquared_checked_all
    (outer inner : ℕ) (hOuter : outer < 14) (hInner : inner < 20) :
    expressionCoefficient bSquaredLeftExpression outer inner =
      expressionCoefficient bSquaredRightExpression outer inner := by
  exact
    if h0 : outer < 2 then by
      exact bSquared_checked_outer_0_1 outer
        (by omega) (by omega) inner hInner
    else if h2 : outer < 4 then by
      exact bSquared_checked_outer_2_3 outer
        (by omega) (by omega) inner hInner
    else if h4 : outer < 6 then by
      exact bSquared_checked_outer_4_5 outer
        (by omega) (by omega) inner hInner
    else if h6 : outer < 8 then by
      exact bSquared_checked_outer_6_7 outer
        (by omega) (by omega) inner hInner
    else if h8 : outer < 10 then by
      exact bSquared_checked_outer_8_9 outer
        (by omega) (by omega) inner hInner
    else if h10 : outer < 12 then by
      exact bSquared_checked_outer_10_11 outer
        (by omega) (by omega) inner hInner
    else if h12 : outer < 14 then by
