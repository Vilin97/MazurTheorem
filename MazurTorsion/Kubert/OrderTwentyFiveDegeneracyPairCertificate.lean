  .add (.mul (.atom pairNumeratorTable) (.atom reducedDenominatorTable)) (.neg (.mul (.atom
    pairDenominatorTable) (.atom reducedNumeratorTable)))

def pairComparisonRightExpression : Expression :=
  .mul (.atom curveTable) (.atom pairQuotientTable)

