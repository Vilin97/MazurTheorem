        (by omega) (by omega) inner hInner
    else by
      omega

theorem bSquared_polynomial :
    expressionPolynomial bSquaredLeftExpression =
      expressionPolynomial bSquaredRightExpression := by
  have hLeftOuter : bSquaredLeftExpression.outerBound ≤ 14 := by decide
  have hRightOuter : bSquaredRightExpression.outerBound ≤ 14 := by decide
  have hLeftInner : bSquaredLeftExpression.innerBound ≤ 20 := by decide
  have hRightInner : bSquaredRightExpression.innerBound ≤ 20 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 14
  · by_cases hInner : inner < 20
    · exact bSquared_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bSquaredLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bSquaredRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bSquaredLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bSquaredRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bSquared_evaluation (r s : ℚ) :
    evaluateExpression bSquaredLeftExpression r s =
      evaluateExpression bSquaredRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bSquared_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

