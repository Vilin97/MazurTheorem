theorem pairNumerator_polynomial :
    expressionPolynomial pairNumeratorLeftExpression =
      expressionPolynomial pairNumeratorRightExpression := by
  have hLeftOuter : pairNumeratorLeftExpression.outerBound ≤ 24 := by decide
  have hRightOuter : pairNumeratorRightExpression.outerBound ≤ 24 := by decide
  have hLeftInner : pairNumeratorLeftExpression.innerBound ≤ 34 := by decide
  have hRightInner : pairNumeratorRightExpression.innerBound ≤ 34 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 24
  · by_cases hInner : inner < 34
    · exact pairNumerator_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge pairNumeratorLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge pairNumeratorRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge pairNumeratorLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge pairNumeratorRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem pairNumerator_evaluation (r s : ℚ) :
    evaluateExpression pairNumeratorLeftExpression r s =
      evaluateExpression pairNumeratorRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) pairNumerator_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

