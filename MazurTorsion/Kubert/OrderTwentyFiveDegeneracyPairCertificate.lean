theorem pairDenominator_polynomial :
    expressionPolynomial pairDenominatorLeftExpression =
      expressionPolynomial pairDenominatorRightExpression := by
  have hLeftOuter : pairDenominatorLeftExpression.outerBound ≤ 24 := by decide
  have hRightOuter : pairDenominatorRightExpression.outerBound ≤ 24 := by decide
  have hLeftInner : pairDenominatorLeftExpression.innerBound ≤ 34 := by decide
  have hRightInner : pairDenominatorRightExpression.innerBound ≤ 34 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 24
  · by_cases hInner : inner < 34
    · exact pairDenominator_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge pairDenominatorLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge pairDenominatorRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge pairDenominatorLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge pairDenominatorRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem pairDenominator_evaluation (r s : ℚ) :
    evaluateExpression pairDenominatorLeftExpression r s =
      evaluateExpression pairDenominatorRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) pairDenominator_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

