theorem pairComparison_polynomial :
    expressionPolynomial pairComparisonLeftExpression =
      expressionPolynomial pairComparisonRightExpression := by
  have hLeftOuter : pairComparisonLeftExpression.outerBound ≤ 33 := by decide
  have hRightOuter : pairComparisonRightExpression.outerBound ≤ 33 := by decide
  have hLeftInner : pairComparisonLeftExpression.innerBound ≤ 72 := by decide
  have hRightInner : pairComparisonRightExpression.innerBound ≤ 72 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 33
  · by_cases hInner : inner < 72
    · exact pairComparison_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge pairComparisonLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge pairComparisonRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge pairComparisonLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge pairComparisonRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem pairComparison_evaluation (r s : ℚ) :
    evaluateExpression pairComparisonLeftExpression r s =
      evaluateExpression pairComparisonRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) pairComparison_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

