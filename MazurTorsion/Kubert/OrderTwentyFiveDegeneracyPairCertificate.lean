theorem ad_polynomial :
    expressionPolynomial adLeftExpression =
      expressionPolynomial adRightExpression := by
  have hLeftOuter : adLeftExpression.outerBound ≤ 18 := by decide
  have hRightOuter : adRightExpression.outerBound ≤ 18 := by decide
  have hLeftInner : adLeftExpression.innerBound ≤ 25 := by decide
  have hRightInner : adRightExpression.innerBound ≤ 25 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 18
  · by_cases hInner : inner < 25
    · exact ad_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge adLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge adRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge adLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge adRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem ad_evaluation (r s : ℚ) :
    evaluateExpression adLeftExpression r s =
      evaluateExpression adRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) ad_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

