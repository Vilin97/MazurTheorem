private theorem bezoutDataIdentity :
    Two.add (Two.mul uData fData) (Two.mul vData hData) =
      resultantData := by
  decide

/-- The degree-eight exceptional factor left after eliminating r. -/
def exceptionalPolynomial (s : ℚ) : ℚ :=
  5 * s ^ 8 + 5 * s ^ 7 - 40 * s ^ 6 + 55 * s ^ 5 -
    19 * s ^ 4 - 15 * s ^ 3 + 11 * s ^ 2 - 1

private theorem evalFData (r s : ℚ) :
    Two.eval fData r s = orderTwentyFiveRawSutherlandF r s := by
  norm_num [fData, Two.eval, One.eval, evalWith,
    orderTwentyFiveRawSutherlandF]
  ring

private theorem evalHData (r s : ℚ) :
    Two.eval hData r s =
      A r s * L r s * T r s + B r s * D r s ^ 2 * E r s := by
  norm_num [hData, Two.eval, One.eval, evalWith, A, B, D, E, L, T]
  ring

private theorem evalResultantData (r s : ℚ) :
    Two.eval resultantData r s =
      -(s ^ 4 * (s - 1) ^ 53 * exceptionalPolynomial s) := by
  norm_num [resultantData, Two.eval, One.eval, evalWith,
    exceptionalPolynomial]
  ring

private theorem bezoutIdentity (r s : ℚ) :
    Two.eval uData r s * orderTwentyFiveRawSutherlandF r s +
        Two.eval vData r s *
          (A r s * L r s * T r s + B r s * D r s ^ 2 * E r s) =
      -(s ^ 4 * (s - 1) ^ 53 * exceptionalPolynomial s) := by
  have h := congrArg (fun p => Two.eval p r s) bezoutDataIdentity
  simpa only [Two.eval_add, Two.eval_mul, evalFData, evalHData,
    evalResultantData] using h

private theorem exceptionalPolynomialModTwo_no_projective_zero :
    ∀ m n : ZMod 2,
      5 * m ^ 8 + 5 * m ^ 7 * n - 40 * m ^ 6 * n ^ 2 +
          55 * m ^ 5 * n ^ 3 - 19 * m ^ 4 * n ^ 4 -
          15 * m ^ 3 * n ^ 5 + 11 * m ^ 2 * n ^ 6 - n ^ 8 = 0 →
        m = 0 ∧ n = 0 := by
  decide

/-- The degree-eight elimination factor has no rational root.  Its
homogenization has no projective zero after reduction modulo two. -/
theorem exceptionalPolynomial_ne_zero (s : ℚ) :
    exceptionalPolynomial s ≠ 0 := by
  intro hs
  simp only [exceptionalPolynomial] at hs
  have hden : (s.den : ℚ) ≠ 0 := by
    exact_mod_cast s.den_ne_zero
  have hnum : (s.num : ℚ) = s * (s.den : ℚ) :=
    (div_eq_iff hden).mp (Rat.num_div_den s)
  have hhomogeneousRat :
      ((5 * s.num ^ 8 + 5 * s.num ^ 7 * (s.den : ℤ) -
          40 * s.num ^ 6 * (s.den : ℤ) ^ 2 +
          55 * s.num ^ 5 * (s.den : ℤ) ^ 3 -
          19 * s.num ^ 4 * (s.den : ℤ) ^ 4 -
          15 * s.num ^ 3 * (s.den : ℤ) ^ 5 +
          11 * s.num ^ 2 * (s.den : ℤ) ^ 6 -
          (s.den : ℤ) ^ 8 : ℤ) : ℚ) = 0 := by
    push_cast
    rw [hnum]
    linear_combination (s.den : ℚ) ^ 8 * hs
  have hhomogeneous :
      5 * s.num ^ 8 + 5 * s.num ^ 7 * (s.den : ℤ) -
          40 * s.num ^ 6 * (s.den : ℤ) ^ 2 +
          55 * s.num ^ 5 * (s.den : ℤ) ^ 3 -
          19 * s.num ^ 4 * (s.den : ℤ) ^ 4 -
          15 * s.num ^ 3 * (s.den : ℤ) ^ 5 +
          11 * s.num ^ 2 * (s.den : ℤ) ^ 6 -
          (s.den : ℤ) ^ 8 = 0 := by
    exact_mod_cast hhomogeneousRat
  have hmodTwo :
      5 * (s.num : ZMod 2) ^ 8 +
          5 * (s.num : ZMod 2) ^ 7 * (s.den : ZMod 2) -
          40 * (s.num : ZMod 2) ^ 6 * (s.den : ZMod 2) ^ 2 +
          55 * (s.num : ZMod 2) ^ 5 * (s.den : ZMod 2) ^ 3 -
          19 * (s.num : ZMod 2) ^ 4 * (s.den : ZMod 2) ^ 4 -
          15 * (s.num : ZMod 2) ^ 3 * (s.den : ZMod 2) ^ 5 +
          11 * (s.num : ZMod 2) ^ 2 * (s.den : ZMod 2) ^ 6 -
          (s.den : ZMod 2) ^ 8 = 0 := by
    simpa only [Int.cast_sub, Int.cast_add, Int.cast_mul, Int.cast_pow,
      Int.cast_ofNat, Int.cast_natCast, Int.cast_zero] using
      congrArg (fun z : ℤ ↦ (z : ZMod 2)) hhomogeneous
  have hzero := exceptionalPolynomialModTwo_no_projective_zero
    (s.num : ZMod 2) (s.den : ZMod 2) hmodTwo
  have hcoprime : IsCoprime s.num (s.den : ℤ) := by
    rw [Int.isCoprime_iff_nat_coprime]
    simpa using s.reduced
  have hcoprimeTwo := hcoprime.map (Int.castRingHom (ZMod 2))
  change IsCoprime (s.num : ZMod 2) (s.den : ZMod 2) at hcoprimeTwo
  rw [hzero.1, hzero.2] at hcoprimeTwo
  exact not_isCoprime_zero_zero hcoprimeTwo

