theorem powerTwoReduction_polynomial :
    expressionPolynomial powerTwoReductionLeftExpression =
      expressionPolynomial powerTwoReductionRightExpression := by
  have hLeftOuter : powerTwoReductionLeftExpression.outerBound ≤ 20 := by decide
  have hRightOuter : powerTwoReductionRightExpression.outerBound ≤ 20 := by decide
  have hLeftInner : powerTwoReductionLeftExpression.innerBound ≤ 78 := by decide
  have hRightInner : powerTwoReductionRightExpression.innerBound ≤ 78 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 20
  · by_cases hInner : inner < 78
    · exact powerTwoReduction_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge powerTwoReductionLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge powerTwoReductionRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge powerTwoReductionLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge powerTwoReductionRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem powerTwoReduction_evaluation (r s : ℚ) :
    evaluateExpression powerTwoReductionLeftExpression r s =
      evaluateExpression powerTwoReductionRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) powerTwoReduction_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

