theorem denominatorSquare_polynomial :
    expressionPolynomial denominatorSquareLeftExpression =
      expressionPolynomial denominatorSquareRightExpression := by
  have hLeftOuter : denominatorSquareLeftExpression.outerBound ≤ 2 := by decide
  have hRightOuter : denominatorSquareRightExpression.outerBound ≤ 2 := by decide
  have hLeftInner : denominatorSquareLeftExpression.innerBound ≤ 72 := by decide
  have hRightInner : denominatorSquareRightExpression.innerBound ≤ 72 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 2
  · by_cases hInner : inner < 72
    · exact denominatorSquare_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge denominatorSquareLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge denominatorSquareRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge denominatorSquareLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge denominatorSquareRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem denominatorSquare_evaluation (r s : ℚ) :
    evaluateExpression denominatorSquareLeftExpression r s =
      evaluateExpression denominatorSquareRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) denominatorSquare_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

