private theorem tangentReduction_checked_all
    (outer inner : ℕ) (hOuter : outer < 12) (hInner : inner < 23) :
    expressionCoefficient tangentReductionLeftExpression outer inner =
      expressionCoefficient tangentReductionRightExpression outer inner := by
  exact
