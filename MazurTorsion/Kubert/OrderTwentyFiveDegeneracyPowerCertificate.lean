theorem powerFourReduction_polynomial :
    expressionPolynomial powerFourReductionLeftExpression =
      expressionPolynomial powerFourReductionRightExpression := by
  have hLeftOuter : powerFourReductionLeftExpression.outerBound ≤ 20 := by decide
  have hRightOuter : powerFourReductionRightExpression.outerBound ≤ 20 := by decide
  have hLeftInner : powerFourReductionLeftExpression.innerBound ≤ 149 := by decide
  have hRightInner : powerFourReductionRightExpression.innerBound ≤ 149 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 20
  · by_cases hInner : inner < 149
    · exact powerFourReduction_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge powerFourReductionLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge powerFourReductionRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge powerFourReductionLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge powerFourReductionRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem powerFourReduction_evaluation (r s : ℚ) :
    evaluateExpression powerFourReductionLeftExpression r s =
      evaluateExpression powerFourReductionRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) powerFourReduction_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

