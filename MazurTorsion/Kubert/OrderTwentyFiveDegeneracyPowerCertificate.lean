  have hRightOuter : powerFiveReductionRightExpression.outerBound ≤ 20 := by decide
  have hLeftInner : powerFiveReductionLeftExpression.innerBound ≤ 184 := by decide
  have hRightInner : powerFiveReductionRightExpression.innerBound ≤ 184 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 20
  · by_cases hInner : inner < 184
    · exact powerFiveReduction_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge powerFiveReductionLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge powerFiveReductionRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge powerFiveReductionLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge powerFiveReductionRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem powerFiveReduction_evaluation (r s : ℚ) :
    evaluateExpression powerFiveReductionLeftExpression r s =
      evaluateExpression powerFiveReductionRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) powerFiveReduction_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

