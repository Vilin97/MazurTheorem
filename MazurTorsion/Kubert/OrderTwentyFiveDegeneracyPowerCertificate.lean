theorem tangentReduction_polynomial :
    expressionPolynomial tangentReductionLeftExpression =
      expressionPolynomial tangentReductionRightExpression := by
  have hLeftOuter : tangentReductionLeftExpression.outerBound ≤ 12 := by decide
  have hRightOuter : tangentReductionRightExpression.outerBound ≤ 12 := by decide
  have hLeftInner : tangentReductionLeftExpression.innerBound ≤ 23 := by decide
  have hRightInner : tangentReductionRightExpression.innerBound ≤ 23 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 12
  · by_cases hInner : inner < 23
    · exact tangentReduction_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge tangentReductionLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge tangentReductionRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge tangentReductionLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge tangentReductionRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem tangentReduction_evaluation (r s : ℚ) :
    evaluateExpression tangentReductionLeftExpression r s =
      evaluateExpression tangentReductionRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) tangentReduction_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

