    remainder3Coefficient5 ^ 2 *
        remainder2Coefficient2 =
      remainder3Coefficient1 *
          (remainder3Coefficient5 *
            remainder2Coefficient6) +
      remainder3Coefficient2 *
          (remainder3Coefficient5 * remainder2Coefficient5 -
            remainder3Coefficient4 * remainder2Coefficient6) +
        remainder2Coefficient6 ^ 2 * exceptional2 *
          remainder4Coefficient2 := by
  rw [pow_two, pow_two]
  change recurrence2Scalar2Left =
    recurrence2Scalar2Shift +
      recurrence2Scalar2Main +
      recurrence2Scalar2Exceptional
  ext n
  by_cases h : n ≤ 379
  · interval_cases n <;> norm_num [Polynomial.coeff_add,
      recurrence2Scalar2Left_coeff_high]
  · rw [recurrence2Scalar2Left_coeff_high n (by omega)]

