theorem scalarResidual4Coefficient0 :
    remainder5Coefficient3 ^ 2 * remainder4Coefficient0 =
      remainder5Coefficient0 *
          (remainder5Coefficient3 * remainder4Coefficient3 -
            remainder5Coefficient2 * remainder4Coefficient4) +
        remainder4Coefficient4 ^ 2 * exceptional4 *
          remainder6Coefficient0 := by
  rw [pow_two, pow_two]
  change recurrence4Scalar0Left =
    recurrence4Scalar0Main + recurrence4Scalar0Exceptional
  ext n
  by_cases h : n ≤ 522
  · interval_cases n <;> norm_num [Polynomial.coeff_add]
  · have hn : 522 < n := by omega
    rw [recurrence4Scalar0Left_coeff_high n hn]
    rw [Polynomial.coeff_add]
    rw [recurrence4Scalar0Main_coeff_high n hn]
    rw [recurrence4Scalar0Exceptional_coeff_high n hn]
    norm_num

theorem scalarResidual4Coefficient1 :
    remainder5Coefficient3 ^ 2 * remainder4Coefficient1 =
      remainder5Coefficient0 * remainder5Coefficient3 *
          remainder4Coefficient4 +
        remainder5Coefficient1 *
          (remainder5Coefficient3 * remainder4Coefficient3 -
            remainder5Coefficient2 * remainder4Coefficient4) +
        remainder4Coefficient4 ^ 2 * exceptional4 *
          remainder6Coefficient1 := by
  rw [pow_two, pow_two]
  rw [mul_assoc remainder5Coefficient0 remainder5Coefficient3
    remainder4Coefficient4]
  change recurrence4Scalar1Left =
    recurrence4Scalar1First + recurrence4Scalar1Second +
      recurrence4Scalar1Exceptional
  ext n
  by_cases h : n ≤ 518
  · interval_cases n <;> norm_num [Polynomial.coeff_add]
  · have hn : 518 < n := by omega
    rw [recurrence4Scalar1Left_coeff_high n hn]
    simp only [Polynomial.coeff_add]
    rw [recurrence4Scalar1First_coeff_high n hn]
    rw [recurrence4Scalar1Second_coeff_high n hn]
    rw [recurrence4Scalar1Exceptional_coeff_high n hn]
    norm_num

theorem scalarResidual4Coefficient2 :
    remainder5Coefficient3 ^ 2 * remainder4Coefficient2 =
      remainder5Coefficient1 * remainder5Coefficient3 *
          remainder4Coefficient4 +
        remainder5Coefficient2 *
