theorem pointProduct_polynomial :
    expressionPolynomial pointProductLeftExpression =
      expressionPolynomial pointProductRightExpression := by
  have hLeftOuter : pointProductLeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : pointProductRightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : pointProductLeftExpression.innerBound ≤ 18 := by decide
  have hRightInner : pointProductRightExpression.innerBound ≤ 18 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 18
    · exact pointProduct_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge pointProductLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge pointProductRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge pointProductLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge pointProductRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem pointProduct_evaluation (r s : ℚ) :
    evaluateExpression pointProductLeftExpression r s =
      evaluateExpression pointProductRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) pointProduct_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

