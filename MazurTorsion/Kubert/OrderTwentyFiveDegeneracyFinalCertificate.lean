private theorem tangentNumerator_checked_all
    (outer inner : ℕ) (hOuter : outer < 11) (hInner : inner < 17) :
    expressionCoefficient tangentNumeratorLeftExpression outer inner =
      expressionCoefficient tangentNumeratorRightExpression outer inner := by
  exact
    if h0 : outer < 2 then by
      exact tangentNumerator_checked_outer_0_1 outer
        (by omega) (by omega) inner hInner
    else if h2 : outer < 4 then by
      exact tangentNumerator_checked_outer_2_3 outer
        (by omega) (by omega) inner hInner
    else if h4 : outer < 6 then by
      exact tangentNumerator_checked_outer_4_5 outer
        (by omega) (by omega) inner hInner
    else if h6 : outer < 8 then by
      exact tangentNumerator_checked_outer_6_7 outer
        (by omega) (by omega) inner hInner
    else if h8 : outer < 10 then by
      exact tangentNumerator_checked_outer_8_9 outer
        (by omega) (by omega) inner hInner
    else if h10 : outer < 11 then by
      exact tangentNumerator_checked_outer_10_10 outer
        (by omega) (by omega) inner hInner
    else by
      omega

theorem tangentNumerator_polynomial :
    expressionPolynomial tangentNumeratorLeftExpression =
      expressionPolynomial tangentNumeratorRightExpression := by
  have hLeftOuter : tangentNumeratorLeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : tangentNumeratorRightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : tangentNumeratorLeftExpression.innerBound ≤ 17 := by decide
  have hRightInner : tangentNumeratorRightExpression.innerBound ≤ 17 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 17
    · exact tangentNumerator_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge tangentNumeratorLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge tangentNumeratorRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge tangentNumeratorLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge tangentNumeratorRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem tangentNumerator_evaluation (r s : ℚ) :
    evaluateExpression tangentNumeratorLeftExpression r s =
      evaluateExpression tangentNumeratorRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) tangentNumerator_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

