theorem bridgeNM3_polynomial :
    expressionPolynomial bridgeNM3LeftExpression =
      expressionPolynomial bridgeNM3RightExpression := by
  have hLeftOuter : bridgeNM3LeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : bridgeNM3RightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeNM3LeftExpression.innerBound ≤ 145 := by decide
  have hRightInner : bridgeNM3RightExpression.innerBound ≤ 145 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 145
    · exact bridgeNM3_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeNM3LeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeNM3RightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeNM3LeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeNM3RightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bridgeNM3_evaluation (r s : ℚ) :
    evaluateExpression bridgeNM3LeftExpression r s =
      evaluateExpression bridgeNM3RightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bridgeNM3_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

