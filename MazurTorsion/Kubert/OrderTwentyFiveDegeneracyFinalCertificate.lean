theorem bridgeR3M_polynomial :
    expressionPolynomial bridgeR3MLeftExpression =
      expressionPolynomial bridgeR3MRightExpression := by
  have hLeftOuter : bridgeR3MLeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : bridgeR3MRightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeR3MLeftExpression.innerBound ≤ 146 := by decide
  have hRightInner : bridgeR3MRightExpression.innerBound ≤ 146 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 146
    · exact bridgeR3M_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeR3MLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeR3MRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeR3MLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeR3MRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bridgeR3M_evaluation (r s : ℚ) :
    evaluateExpression bridgeR3MLeftExpression r s =
      evaluateExpression bridgeR3MRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bridgeR3M_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

