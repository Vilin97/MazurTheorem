theorem bridgeNM2_polynomial :
    expressionPolynomial bridgeNM2LeftExpression =
      expressionPolynomial bridgeNM2RightExpression := by
  have hLeftOuter : bridgeNM2LeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : bridgeNM2RightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeNM2LeftExpression.innerBound ≤ 110 := by decide
  have hRightInner : bridgeNM2RightExpression.innerBound ≤ 110 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 110
    · exact bridgeNM2_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeNM2LeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeNM2RightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeNM2LeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeNM2RightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bridgeNM2_evaluation (r s : ℚ) :
    evaluateExpression bridgeNM2LeftExpression r s =
      evaluateExpression bridgeNM2RightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bridgeNM2_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

