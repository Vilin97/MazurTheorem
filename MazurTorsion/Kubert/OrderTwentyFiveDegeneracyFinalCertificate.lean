theorem bridgeR2M_polynomial :
    expressionPolynomial bridgeR2MLeftExpression =
      expressionPolynomial bridgeR2MRightExpression := by
  have hLeftOuter : bridgeR2MLeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : bridgeR2MRightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeR2MLeftExpression.innerBound ≤ 110 := by decide
  have hRightInner : bridgeR2MRightExpression.innerBound ≤ 110 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 110
    · exact bridgeR2M_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeR2MLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeR2MRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeR2MLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeR2MRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bridgeR2M_evaluation (r s : ℚ) :
    evaluateExpression bridgeR2MLeftExpression r s =
      evaluateExpression bridgeR2MRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bridgeR2M_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

