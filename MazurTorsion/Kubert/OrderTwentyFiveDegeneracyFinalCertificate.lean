  have hRightOuter : bridgeNM4RightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeNM4LeftExpression.innerBound ≤ 180 := by decide
  have hRightInner : bridgeNM4RightExpression.innerBound ≤ 180 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 180
    · exact bridgeNM4_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeNM4LeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeNM4RightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeNM4LeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeNM4RightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

