theorem pointDenominatorSquare_polynomial :
    expressionPolynomial pointDenominatorSquareLeftExpression =
      expressionPolynomial pointDenominatorSquareRightExpression := by
  have hLeftOuter : pointDenominatorSquareLeftExpression.outerBound ≤ 10 := by decide
  have hRightOuter : pointDenominatorSquareRightExpression.outerBound ≤ 10 := by decide
  have hLeftInner : pointDenominatorSquareLeftExpression.innerBound ≤ 18 := by decide
  have hRightInner : pointDenominatorSquareRightExpression.innerBound ≤ 18 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 10
  · by_cases hInner : inner < 18
    · exact pointDenominatorSquare_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge pointDenominatorSquareLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge pointDenominatorSquareRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge pointDenominatorSquareLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge pointDenominatorSquareRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem pointDenominatorSquare_evaluation (r s : ℚ) :
    evaluateExpression pointDenominatorSquareLeftExpression r s =
      evaluateExpression pointDenominatorSquareRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) pointDenominatorSquare_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

