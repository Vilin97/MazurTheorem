  have hRightOuter : bridgeR3M2RightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeR3M2LeftExpression.innerBound ≤ 181 := by decide
  have hRightInner : bridgeR3M2RightExpression.innerBound ≤ 181 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 181
    · exact bridgeR3M2_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeR3M2LeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeR3M2RightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeR3M2LeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeR3M2RightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

