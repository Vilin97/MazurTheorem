theorem bridgeR2M3_polynomial :
    expressionPolynomial bridgeR2M3LeftExpression =
      expressionPolynomial bridgeR2M3RightExpression := by
  have hLeftOuter : bridgeR2M3LeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : bridgeR2M3RightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeR2M3LeftExpression.innerBound ≤ 180 := by decide
  have hRightInner : bridgeR2M3RightExpression.innerBound ≤ 180 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 180
    · exact bridgeR2M3_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeR2M3LeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeR2M3RightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeR2M3LeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeR2M3RightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bridgeR2M3_evaluation (r s : ℚ) :
    evaluateExpression bridgeR2M3LeftExpression r s =
      evaluateExpression bridgeR2M3RightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bridgeR2M3_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

