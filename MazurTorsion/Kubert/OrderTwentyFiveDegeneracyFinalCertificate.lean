  have hLeftOuter : bridgeNMLeftExpression.outerBound ≤ 11 := by decide
  have hRightOuter : bridgeNMRightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeNMLeftExpression.innerBound ≤ 75 := by decide
  have hRightInner : bridgeNMRightExpression.innerBound ≤ 75 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 75
    · exact bridgeNM_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeNMLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeNMRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeNMLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeNMRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bridgeNM_evaluation (r s : ℚ) :
    evaluateExpression bridgeNMLeftExpression r s =
      evaluateExpression bridgeNMRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bridgeNM_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

