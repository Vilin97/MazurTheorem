theorem bridgeInner_polynomial :
    expressionPolynomial bridgeInnerLeftExpression =
      expressionPolynomial bridgeInnerRightExpression := by
  have hLeftOuter : bridgeInnerLeftExpression.outerBound ≤ 10 := by decide
  have hRightOuter : bridgeInnerRightExpression.outerBound ≤ 10 := by decide
  have hLeftInner : bridgeInnerLeftExpression.innerBound ≤ 181 := by decide
  have hRightInner : bridgeInnerRightExpression.innerBound ≤ 181 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 10
  · by_cases hInner : inner < 181
    · exact bridgeInner_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeInnerLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeInnerRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeInnerLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeInnerRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem bridgeInner_evaluation (r s : ℚ) :
    evaluateExpression bridgeInnerLeftExpression r s =
      evaluateExpression bridgeInnerRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) bridgeInner_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

