  have hRightOuter : bridgeR2M2RightExpression.outerBound ≤ 11 := by decide
  have hLeftInner : bridgeR2M2LeftExpression.innerBound ≤ 145 := by decide
  have hRightInner : bridgeR2M2RightExpression.innerBound ≤ 145 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 11
  · by_cases hInner : inner < 145
    · exact bridgeR2M2_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge bridgeR2M2LeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge bridgeR2M2RightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge bridgeR2M2LeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge bridgeR2M2RightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

