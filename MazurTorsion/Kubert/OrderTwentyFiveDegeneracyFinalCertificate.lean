theorem pointNumeratorSquare_polynomial :
    expressionPolynomial pointNumeratorSquareLeftExpression =
      expressionPolynomial pointNumeratorSquareRightExpression := by
  have hLeftOuter : pointNumeratorSquareLeftExpression.outerBound ≤ 12 := by decide
  have hRightOuter : pointNumeratorSquareRightExpression.outerBound ≤ 12 := by decide
  have hLeftInner : pointNumeratorSquareLeftExpression.innerBound ≤ 18 := by decide
  have hRightInner : pointNumeratorSquareRightExpression.innerBound ≤ 18 := by decide
  apply Polynomial.ext
  intro outer
  apply Polynomial.ext
  intro inner
  rw [expressionPolynomial_coeff_coeff, expressionPolynomial_coeff_coeff]
  by_cases hOuter : outer < 12
  · by_cases hInner : inner < 18
    · exact pointNumeratorSquare_checked_all outer inner hOuter hInner
    · rw [expressionCoefficient_zero_of_inner_ge pointNumeratorSquareLeftExpression outer inner
          (le_trans hLeftInner (Nat.le_of_not_gt hInner)),
        expressionCoefficient_zero_of_inner_ge pointNumeratorSquareRightExpression outer inner
          (le_trans hRightInner (Nat.le_of_not_gt hInner))]
  · rw [expressionCoefficient_zero_of_outer_ge pointNumeratorSquareLeftExpression outer inner
        (le_trans hLeftOuter (Nat.le_of_not_gt hOuter)),
      expressionCoefficient_zero_of_outer_ge pointNumeratorSquareRightExpression outer inner
        (le_trans hRightOuter (Nat.le_of_not_gt hOuter))]

theorem pointNumeratorSquare_evaluation (r s : ℚ) :
    evaluateExpression pointNumeratorSquareLeftExpression r s =
      evaluateExpression pointNumeratorSquareRightExpression r s := by
  have h := congrArg (evaluatePolynomial r s) pointNumeratorSquare_polynomial
  rw [evaluatePolynomial_expressionPolynomial,
    evaluatePolynomial_expressionPolynomial] at h
  exact h

