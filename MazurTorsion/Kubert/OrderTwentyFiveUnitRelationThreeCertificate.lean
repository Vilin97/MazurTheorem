/-- Internal exact coefficient certificate consumed by the
actual-coordinate order-25 orbit proof. -/
theorem orderTwentyFiveUnitRelationThreeCertificate
    (r s : ℚ) (hs : s ≠ 0) (hA : A r s ≠ 0) (hC : C r s ≠ 0) (hD : D r s ≠ 0) (hL : L r s ≠ 0)
    (hJ : J r s ≠ 0) (hP6 : P6 r s ≠ 0) (hP9 : P9 r s ≠ 0)
    (hF : F r s = 0) :
    y8 r s - y4 r s - y8 r s * y2 r s * (y9 r s - y8 r s) = 0 := by
  have hpoly : term0 r s + term1 r s + term2 r s + term3 r s = 0 := by
    rw [polynomial_certificate, hF]
    ring
  simp only [y2, y4, y8, y9]
  field_simp [hs, hA, hC, hD, hL, hJ, hP6, hP9]
  simp only [term0, term1, term2, term3] at hpoly
  linear_combination hpoly

